≈services:
  postgres:
    image: postgres:16-alpine
    container_name: soraschool_postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: soraschool
    ports:
      - "5434:5432"
    volumes:
      - soraschool_postgres:/var/lib/postgresql/data

  redis:
    image: redis:7-alpine
    container_name: soraschool_redis
    restart: unless-stopped
    ports:
      - "6380:6379"

volumes:
  soraschool_postgres:
