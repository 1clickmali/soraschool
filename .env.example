NODE_ENV=development
PORT=4000
APP_NAME="SoraSchool"
SUPPORT_EMAIL="contact@soratech.ci"
SUPPORT_PHONE="0704928068"
SUPPORT_ADDRESS="Abidjan, Côte d'Ivoire"
SUPPORT_WEBSITE="https://soratech.ci"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
STORAGE_URL="http://localhost:4000/api/platform/assets"
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/soraschool?schema=public"
REDIS_URL="redis://localhost:6380"
CORS_ORIGIN="http://localhost:5174,http://localhost:3000"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
UPLOAD_ROOT="./storage"
PUBLIC_API_URL="http://localhost:4000"
MOCK_SMS=true
MAX_UPLOAD_MB=10

# Africa's Talking SMS (https://africastalking.com)
# Créer un compte, aller dans Settings > API Key
AT_API_KEY=""
AT_USERNAME="sandbox"
# AT_SENDER_ID="SoraSchool"  # optionnel, selon opérateur
# Logue les codes OTP dans les logs serveur (Railway logs) - DÉSACTIVER en production réelle
OTP_LOG_CODES=false

# SMTP — emails transactionnels (OTP, reçus, bienvenue...)
# Laisser vide pour désactiver les emails (fallback SMS uniquement)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="votre@email.com"
# SMTP_PASS="votre-mot-de-passe-application"
# SMTP_FROM="SoraSchool <noreply@soraschool.ci>"
# SMTP_SECURE=false
